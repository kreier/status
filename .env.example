# Copy this to .env (git-ignored) and fill in real values.

# From the Cloudflare Zero Trust dashboard: Networks > Tunnels > create a tunnel,
# choose "Docker" as the connector, copy the token from the install command shown there.
TUNNEL_TOKEN=

# GitHub username whose repos should be listed
GITHUB_USERNAME=kreier

# Optional: personal access token (no scopes needed for public repos) to raise the
# GitHub API rate limit from 60/hr to 5000/hr. Leave blank to use unauthenticated requests.
GITHUB_TOKEN=
